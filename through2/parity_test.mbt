///|
test "through2-master parity report documents implemented and non-applicable cases" {
  let report = through2_parity_report()
  inspect(report.contains("classicByteTransform"), content="true")
  inspect(report.contains("classicNoopTransform"), content="true")
  inspect(report.contains("classicFlush"), content="true")
  inspect(report.contains("classicCallbackShorthand"), content="true")
  inspect(report.contains("asyncReturnedValuePushed"), content="true")
  inspect(report.contains("asyncUndefinedSkipsEmission"), content="true")
  inspect(report.contains("asyncRejectedPropagatesError"), content="true")
  inspect(report.contains("asyncgenOneToOne"), content="true")
  inspect(report.contains("asyncgenFanOut"), content="true")
  inspect(report.contains("asyncgenFilter"), content="true")
  inspect(report.contains("asyncgenWithClassicFlush"), content="true")
  inspect(report.contains("asyncgenThrownPropagates"), content="true")
  inspect(report.contains("objectTransformPassthrough"), content="true")
  inspect(report.contains("objectTransformFromReadable"), content="true")
  inspect(report.contains("transformerReusableFactory"), content="true")
  inspect(report.contains("transformerOptionsMerge"), content="true")
  inspect(report.contains("transformerOverrideOptions"), content="true")
  inspect(report.contains("transformerAsyncSupported"), content="true")
  inspect(report.contains("legacyDefault"), content="true")
  inspect(report.contains("legacyDefaultObj"), content="true")
  inspect(report.contains("legacyDefaultCtor"), content="true")
  inspect(report.contains("transformerAsyncgenSupported"), content="true")
  inspect(report.contains("asyncgenDownstreamBackpressure"), content="true")
  inspect(report.contains("asyncgenWritableBackpressure"), content="true")
  inspect(report.contains("asyncgenDestroyMidStream"), content="true")
  inspect(report.contains("asyncgenDestroyRunsFinally"), content="true")
  inspect(report.contains("through2/web"), content="true")
  inspect(report.contains("TransformOptions"), content="true")
}
